{
  "name": "campaignflow",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:platform": "vite -c vite.platform.config.ts",
    "build": "vite build && tsx scripts/seo-artifacts.mts",
    "build:platform": "vite build -c vite.platform.config.ts",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy -c dist/campaignflow_backend/wrangler.json",
    "deploy:platform": "npm run build:platform && wrangler deploy -c dist-platform/campaignflow_platform/wrangler.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:migrate:local": "wrangler d1 migrations apply campaignflow --local --config wrangler.jsonc",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "vitest run",
    "test:backend": "npm --prefix Backend test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@sentry/react": "^11.6.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "lucide-react": "^0.469.0",
    "postcss": "^8.5.28",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "7.18.4",
    "tailwindcss": "3.4.19"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.3",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/qrcode": "^1.5.6",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "puppeteer-core": "^25.12.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.0",
    "vite": "8.3.1",
    "vitest": "^5.0.3",
    "wrangler": "4.149.0"
  }
}
