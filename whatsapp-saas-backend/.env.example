# Server port
PORT=3000

# Shared secret the Cloudflare Worker uses to call this gateway (generate: openssl rand -hex 32)
GATEWAY_SECRET=

# Base URL of the deployed Worker, e.g. https://campaignflow-backend.mhoudou098.workers.dev
WORKER_URL=

# Shared secret for gateway -> Worker progress callbacks (generate: openssl rand -hex 32)
WHATSAPP_WEB_CALLBACK_SECRET=

# Where the WhatsApp session is stored (mount a volume here in production)
AUTH_DATA_PATH=./data
