{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "campaignflow-loadtest",
	"main": "./Backend/src/index.ts",
	"compatibility_date": "2026-09-30",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// NOTE: `limits.cpu_ms` is not supported on the Free plan — re-add it
	// (value 200) when/after switching to a paid plan.
	"vars": {
		"APP_ENV": "development",
		"GEOFENCE_COUNTRIES": "TN",
		// Local-only value for `wrangler dev` on this worker. It is NOT the
		// production secret (`campaignflow-backend` reads COOKIE_SIGNING_KEY
		// from `wrangler secret put`), and this config must never be deployed
		// with bindings that share production state.
		"COOKIE_SIGNING_KEY": "loadtest-cookie-signing-key"
	},
	"d1_databases": [
		{
			"binding": "DB",
			// Isolated from production on purpose: the ids below are
			// placeholders. Before a remote deploy create dedicated resources —
			//   npx wrangler d1 create campaignflow-loadtest
			//   npx wrangler kv namespace create TOKENS
			// — and paste the returned ids here. Deploying with the
			// placeholders fails fast instead of quietly sharing prod state.
			"database_name": "campaignflow-loadtest",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "Backend/migrations"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "CAMPAIGN_LOCK",
				"class_name": "CampaignParticipationLock"
			},
			{
				"name": "WHATSAPP_SENDER",
				"class_name": "WhatsAppBroadcastSender"
			},
			{
				"name": "EMAIL_SENDER",
				"class_name": "EmailBroadcastSender"
			},
			{
				"name": "WHATSAPP_PACING",
				"class_name": "WhatsAppPacingGate"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"CampaignParticipationLock"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"WhatsAppBroadcastSender"
			]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"EmailBroadcastSender",
				"WhatsAppPacingGate"
			]
		}
	],
	"kv_namespaces": [
		{
			"binding": "TOKENS",
			// Placeholder id — never shared with production (see d1 block above);
			// replace with the real `kv namespace create TOKENS` id before use.
			"id": "11111111111111111111111111111111"
		}
	],
	"ratelimits": [
		{
			"name": "API_RATE_LIMITER",
			"namespace_id": "92609301",
			"simple": {
				"limit": 120,
				"period": 60
			}
		},
		{
			"name": "WEBHOOK_RATE_LIMITER",
			"namespace_id": "92609302",
			"simple": {
				"limit": 1200,
				"period": 60
			}
		},
		{
			"name": "PUBLIC_RATE_LIMITER",
			"namespace_id": "92609303",
			"simple": {
				"limit": 300,
				"period": 60
			}
		},
		{
			"name": "AUTH_RATE_LIMITER",
			"namespace_id": "92609304",
			"simple": {
				"limit": 20,
				"period": 60
			}
		}
	]
}
